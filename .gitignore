# Node.js
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.local
.DS_Store
Thumbs.db

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# Android (Tauri Mobile Generated)
# 我们需要保留 gen/android 结构，但忽略构建产物和本地配置
src-tauri/gen/android/.gradle/
src-tauri/gen/android/local.properties
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/.idea/modules.xml
src-tauri/gen/android/.idea/workspace.xml
src-tauri/gen/android/.idea/navEditor.xml
src-tauri/gen/android/.idea/assetWizardSettings.xml
src-tauri/gen/android/.idea/caches
src-tauri/gen/android/.idea/libraries
src-tauri/gen/android/.externalNativeBuild
src-tauri/gen/android/.cxx/
src-tauri/gen/android/captures/

# --- V1.2.1 新增：签名与本地配置（绝不入库）---
src-tauri/gen/android/key.properties
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/*.jks
src-tauri/gen/android/app/*.keystore
# tauri.properties 由 tauri android build 依据 tauri.conf.json 自动生成
src-tauri/gen/android/app/tauri.properties

# IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.py
# 只忽略根目录的 repomix 导出快照（原 *.xml 会把 Android 的 AndroidManifest.xml、
# res/values/*.xml、res/xml/file_paths.xml 全部吞掉，导致 CI 拉代码后工程不可用）
/repomix-output.xml
# --- V1.1.0 新增过滤规则 ---
# 过滤打包产物目录
release_apks/

# 过滤本地运行时的环境切换文件（我们只提交 .env.public 和 .env.personal）
.env

# 过滤编译过程中可能产生的 python 缓存
__pycache__/
*.pyc


*.log